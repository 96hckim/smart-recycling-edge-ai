  <property name="styleSheet">
   <string notr="true">
QWidget {
    background-color: #0B0F17;
    color: #F8FAFC;
    font-family: 'Pretendard', 'Segoe UI', sans-serif;
    font-size: 18px;
}

QLabel {
    background-color: transparent;
}

/* 카드 패널 공통 */
QFrame.kioskPanel {
    background-color: #111827;
    border: 2px solid #1F2937;
    border-radius: 24px;
}

/* 좌측 비디오 뷰어 */
QLabel#lblVideo {
    background-color: #030712;
    border: 2px solid #1E293B;
    border-radius: 20px;
    color: #64748B;
    font-size: 26px;
    font-weight: 800;
}

/* 실시간 하단 가이드 배너 */
QLabel#lblGuideBanner {
    background-color: #0D1927;
    border: 2px solid #0284C7;
    border-radius: 16px;
    color: #38BDF8;
    font-size: 22px;
    font-weight: 800;
    padding: 10px;
}

/* 사용자 세션 */
QLabel#lblUserGreeting { font-size: 30px; font-weight: 900; color: #10B981; }
QLabel#lblSessionMode { font-size: 18px; font-weight: 600; color: #94A3B8; }

/* 4종 스코어보드 박스 */
QFrame.countItemBox {
    background-color: #0D131F;
    border: 1.5px solid #1E293B;
    border-radius: 16px;
}
QLabel.itemCountTitle { font-size: 20px; font-weight: 800; color: #CBD5E1; }
QLabel.itemCountNum { font-size: 36px; font-weight: 900; color: #F8FAFC; }

/* 총 리워드 카드 */
QFrame#frameTotalReward {
    background-color: #0F1D30;
    border: 2px solid #1E40AF;
    border-radius: 20px;
}
QLabel#lblRewardHeader { font-size: 19px; font-weight: 800; color: #94A3B8; }
QLabel#lblTotalPoints { font-size: 42px; font-weight: 900; color: #38BDF8; }
QLabel#lblTotalCarbon { font-size: 20px; font-weight: 800; color: #10B981; }

/* 액션 버튼 */
QPushButton#btnFinishSession {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #10B981, stop:1 #06B6D4);
    color: #FFFFFF;
    font-size: 22px;
    font-weight: 900;
    border: none;
    border-radius: 16px;
}
QPushButton#btnFinishSession:disabled {
    background-color: #1E293B;
    border: 1.5px solid #334155;
    color: #64748B;
}
QPushButton#btnFinishSession:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #059669, stop:1 #0891B2);
}
QPushButton#btnFinishSession:pressed { background-color: #047857; }

QPushButton#btnCancelSession {
    background-color: #1E293B;
    color: #CBD5E1;
    font-size: 20px;
    font-weight: 800;
    border: 1.5px solid #334155;
    border-radius: 16px;
}
QPushButton#btnCancelSession:hover {
    color: #EF4444;
    border-color: #EF4444;
    background-color: rgba(239, 68, 68, 0.12);
}
QPushButton#btnCancelSession:pressed { background-color: rgba(239, 68, 68, 0.2); }
   </string>
