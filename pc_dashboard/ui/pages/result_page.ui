<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ResultPage</class>
 <widget class="QWidget" name="ResultPage">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1920</width>
    <height>920</height>
   </rect>
  </property>
  <property name="styleSheet">
   <string notr="true">
QWidget {
    background-color: #070B14;
    color: #F8FAFC;
    font-family: 'Pretendard', 'Segoe UI', sans-serif;
}

QLabel {
    background-color: transparent;
}

/* 중앙 메인 대시보드 카드 */
QFrame#frameContainer {
    background-color: #0F172A;
    border: 2px solid #1E293B;
    border-radius: 28px;
}

/* 상단 완료 타이틀 */
QLabel#lblTitleIcon { font-size: 68px; }
QLabel#lblResultHeader {
    font-size: 60px;
    font-weight: 900;
    color: #F8FAFC;
    letter-spacing: -0.5px;
}
QLabel#lblResultSub {
    font-size: 40px;
    font-weight: 500;
    color: #94A3B8;
}

/* 중앙 종합 리워드 배너 */
QFrame#frameTotalBanner {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 #11253E, stop:1 #0C362F);
    border: 2px solid #0284C7;
    border-radius: 20px;
}
QLabel#lblPointsTitle, QLabel#lblCarbonTitle {
    font-size: 24px;
    font-weight: 700;
    color: #94A3B8;
}
QLabel#lblTotalPoints {
    font-size: 46px;
    font-weight: 900;
    color: #38BDF8;
}
QLabel#lblTotalCarbon {
    font-size: 46px;
    font-weight: 900;
    color: #10B981;
}
QFrame#bannerDivider {
    background-color: rgba(148, 163, 184, 0.2);
    border: none;
    width: 2px;
}

/* 4종 품목 영수증 카드 */
QFrame.receiptCard {
    background-color: #131E30;
    border: 2px solid #1E293B;
    border-radius: 18px;
}
QLabel.receiptTitle {
    font-size: 24px;
    font-weight: 800;
    color: #94A3B8;
}
QLabel.receiptCount {
    font-size: 42px;
    font-weight: 900;
    color: #475569;
}
QLabel.receiptPoints {
    font-size: 24px;
    font-weight: 800;
    color: #334155;
}

/* 4종 품목 활성화 상태: 종이 -> 캔 -> 페트 -> 비닐 */
QFrame#boxReceiptPaper[active="true"] { background-color: #2D2311; border: 2px solid #F59E0B; }
QLabel#lblRPaperTitle[active="true"] { color: #F8FAFC; }
QLabel#lblRPaperCount[active="true"] { color: #F59E0B; }
QLabel#lblRPaperPoints[active="true"] { color: #F59E0B; }

QFrame#boxReceiptCan[active="true"] { background-color: #0E2922; border: 2px solid #10B981; }
QLabel#lblRCanTitle[active="true"] { color: #F8FAFC; }
QLabel#lblRCanCount[active="true"] { color: #10B981; }
QLabel#lblRCanPoints[active="true"] { color: #10B981; }

QFrame#boxReceiptPet[active="true"] { background-color: #0E273D; border: 2px solid #38BDF8; }
QLabel#lblRPetTitle[active="true"] { color: #F8FAFC; }
QLabel#lblRPetCount[active="true"] { color: #38BDF8; }
QLabel#lblRPetPoints[active="true"] { color: #38BDF8; }

QFrame#boxReceiptVinyl[active="true"] { background-color: #261438; border: 2px solid #A855F7; }
QLabel#lblRVinylTitle[active="true"] { color: #F8FAFC; }
QLabel#lblRVinylCount[active="true"] { color: #C084FC; }
QLabel#lblRVinylPoints[active="true"] { color: #C084FC; }

/* 상태 안내 뱃지 */
QLabel#lblUserNotice {
    background-color: #131E33;
    border: 1.5px solid #334155;
    border-radius: 14px;
    color: #CBD5E1;
    font-size: 19px;
    font-weight: 700;
    padding: 10px 20px;
}
QLabel#lblUserNotice[member="true"] {
    background-color: rgba(16, 185, 129, 0.12);
    border-color: #10B981;
    color: #10B981;
}

/* 하단 확인 버튼 */
QPushButton#btnConfirm {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #10B981, stop:1 #06B6D4);
    color: #FFFFFF;
    font-size: 22px;
    font-weight: 900;
    border: none;
    border-radius: 16px;
}
QPushButton#btnConfirm:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #059669, stop:1 #0891B2);
}
QPushButton#btnConfirm:pressed {
    background-color: #047857;
}
QPushButton#btnConfirm:disabled {
    background-color: #334155;
    color: #64748B;
}
   </string>
