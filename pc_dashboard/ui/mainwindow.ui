  <property name="styleSheet">
   <string notr="true">
QWidget {
    background-color: #0B0F17;
    color: #F8FAFC;
    font-family: 'Pretendard', 'Segoe UI', sans-serif;
    font-size: 16px;
}

/* 상단 글로벌 헤더 */
QFrame#frameHeader {
    background-color: #111827;
    border-bottom: 2px solid #1F2937;
}
QLabel#lblTitle {
    color: #38BDF8;
    font-size: 26px;
    font-weight: 900;
    letter-spacing: 0.5px;
    background: transparent;
}
QLabel#lblConnStatus {
    background-color: #0F172A;
    border: 2px solid #10B981;
    border-radius: 16px;
    padding: 8px 22px;
    color: #10B981;
    font-weight: 900;
    font-size: 16px;
}
QLabel#lblConnStatus[online=&quot;false&quot;] {
    border-color: #EF4444;
    color: #EF4444;
}

/* 하단 수거함 적재 상태 바 */
QFrame#frameBinStatus {
    background-color: #0F172A;
    border-top: 2px solid #1E293B;
    border-bottom: 1.5px solid #1E293B;
}
QLabel#lblStatusTitle { font-size: 24px; font-weight: 900; color: #94A3B8; background: transparent; }
QLabel.binNameLabel { font-size: 22px; font-weight: 800; color: #F1F5F9; background: transparent; }

/* 수거함 대형 게이지 */
QProgressBar.binProgressBar {
    background-color: #080D14;
    border: 2px solid #334155;
    border-radius: 10px;
    text-align: center;
    color: #FFFFFF;
    font-weight: 900;
    font-size: 16px;
}
QProgressBar.binProgressBar::chunk {
    border-radius: 7px;
    margin: 2px;
}
QProgressBar#progressBarPaper::chunk { background-color: #F59E0B; }
QProgressBar#progressBarCan::chunk { background-color: #10B981; }
QProgressBar#progressBarPet::chunk { background-color: #38BDF8; }
QProgressBar#progressBarVinyl::chunk { background-color: #A855F7; }

/* 최하단 텔레메트리 바 */
QLabel#lblTelemetry {
    background-color: #090D15;
    color: #64748B;
    font-size: 13px;
    font-weight: 600;
    padding-left: 24px;
}
