    border-bottom: 1px solid #1F2937;
}

/* 하단 수거함 적재 상태 공통 바 */
QFrame#frameBinStatus {
    background-color: #111827;
    border-top: 1px solid #1F2937;
    border-bottom: 1px solid #1F2937;
}
QLabel#lblStatusTitle { font-size: 17px; font-weight: 700; color: #94A3B8; background: transparent; }
QLabel.binNameLabel { font-size: 16px; font-weight: 600; color: #CBD5E1; background: transparent; }

/* 수거함 정밀 인셋 게이지 */
QProgressBar.binProgressBar {
    background-color: #080D14;
    border: 1px solid #1E293B;
    border-radius: 6px;
    text-align: center;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 12px;
}
QProgressBar.binProgressBar::chunk {
    border-radius: 4px;
    margin: 2px;
}
QProgressBar#progressBarCan::chunk { background-color: #10B981; }
QProgressBar#progressBarPet::chunk { background-color: #38BDF8; }
QProgressBar#progressBarPaper::chunk { background-color: #F59E0B; }
QProgressBar#progressBarGeneral::chunk { background-color: #64748B; }

/* 최하단 텔레메트리 바 */
QLabel#lblTelemetry {
    background-color: #0D131F;
    color: #64748B;
    font-size: 12px;
    padding-left: 20px;
}
