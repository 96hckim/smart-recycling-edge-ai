  <property name="styleSheet">
   <string notr="true">
QWidget {
    background-color: #0B0F17;
    color: #F8FAFC;
    font-family: 'Pretendard', 'Segoe UI', sans-serif;
    font-size: 16px;
}

QLabel#lblMainTitle {
    font-size: 38px;
    font-weight: 800;
    color: #38BDF8;
    background: transparent;
}
QLabel#lblSubTitle {
    font-size: 19px;
    font-weight: 500;
    color: #94A3B8;
    background: transparent;
}

QFrame#frameMemberCard, QFrame#frameGuestCard {
    background-color: #141B28;
    border: 2px solid #232F42;
    border-radius: 20px;
}
QFrame#frameMemberCard:hover { border: 2px solid #10B981; }
QFrame#frameGuestCard:hover { border: 2px solid #38BDF8; }

QLabel#lblMemberTitle { font-size: 26px; font-weight: 800; color: #10B981; background: transparent; }
QLabel#lblGuestTitle { font-size: 26px; font-weight: 800; color: #38BDF8; background: transparent; }

QLabel#lblGuestIcon {
    font-size: 96px;
    color: #38BDF8;
    background-color: rgba(56, 189, 248, 0.08);
    border: 1px solid #25334D;
    border-radius: 20px;
}

QLabel#lblQrCode {
    background-color: #FFFFFF;
    border-radius: 20px;
    color: #0B0F17;
    font-size: 16px;
    font-weight: 700;
}

QLabel#lblMemberDesc, QLabel#lblGuestDesc {
    font-size: 17px;
    color: #94A3B8;
    background: transparent;
    line-height: 1.5;
}

QLabel#lblQrGuideBadge {
    background-color: rgba(16, 185, 129, 0.12);
    border: 2px solid #10B981;
    border-radius: 16px;
    color: #10B981;
    font-size: 19px;
    font-weight: 800;
}

QPushButton#btnGuestStart {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #2563EB, stop:1 #38BDF8);
    color: #FFFFFF;
    font-size: 20px;
    font-weight: 800;
    border: none;
    border-radius: 16px;
}
QPushButton#btnGuestStart:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #1D4ED8, stop:1 #0284C7);
}
QPushButton#btnGuestStart:pressed { background-color: #1E40AF; }
   </string>
