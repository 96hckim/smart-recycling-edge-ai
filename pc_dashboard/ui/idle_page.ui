  <property name="styleSheet">
   <string notr="true">
QWidget {
    background-color: #0B0F17;
    color: #F8FAFC;
    font-family: 'Pretendard', 'Segoe UI', sans-serif;
    font-size: 18px;
}

QLabel {
    background-color: transparent;
}

/* 상단 메인 타이틀 (60px 초대형 폰트) */
QLabel#lblMainTitle {
    font-size: 60px;
    font-weight: 900;
    color: #38BDF8;
    letter-spacing: -1.5px;
}
QLabel#lblSubTitle {
    font-size: 26px;
    font-weight: 600;
    color: #94A3B8;
}

/* 대기 화면 카드 패널 */
QFrame#frameMemberCard, QFrame#frameGuestCard {
    background-color: #111827;
    border: 2px solid #1F2937;
    border-radius: 24px;
}
QFrame#frameMemberCard:hover { border: 2.5px solid #10B981; background-color: #131E2E; }
QFrame#frameGuestCard:hover { border: 2.5px solid #38BDF8; background-color: #131E2E; }

QLabel#lblMemberTitle { font-size: 32px; font-weight: 900; color: #10B981; }
QLabel#lblGuestTitle { font-size: 32px; font-weight: 900; color: #38BDF8; }

/* 중앙 아이콘 박스 */
QLabel#lblGuestIcon {
    font-size: 130px;
    color: #10B981;
    background-color: #0D1927;
    border: 2px solid #1E293B;
    border-radius: 24px;
}

/* QR 코드 라벨 */
QLabel#lblQrCode {
    background-color: #FFFFFF;
    border: 3px solid #38BDF8;
    border-radius: 24px;
    color: #0B0F17;
    font-size: 20px;
    font-weight: 800;
}

QLabel#lblMemberDesc, QLabel#lblGuestDesc {
    font-size: 21px;
    font-weight: 600;
    color: #CBD5E1;
    line-height: 1.4;
}

/* 좌측 QR 안내 뱃지 (높이 76px) */
QLabel#lblQrGuideBadge {
    background-color: rgba(16, 185, 129, 0.12);
    border: 2px solid #10B981;
    border-radius: 18px;
    color: #10B981;
    font-size: 24px;
    font-weight: 900;
}

/* 우측 비회원 시작 버튼 (높이 76px) */
QPushButton#btnGuestStart {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #2563EB, stop:1 #38BDF8);
    color: #FFFFFF;
    font-size: 24px;
    font-weight: 900;
    border: none;
    border-radius: 18px;
}
QPushButton#btnGuestStart:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #1D4ED8, stop:1 #0284C7);
}
QPushButton#btnGuestStart:pressed {
    background-color: #1E40AF;
}
   </string>
